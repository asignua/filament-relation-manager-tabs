{
    "name": "asignua/filament-relation-manager-tabs",
    "description": "Render Filament relation managers as ordinary tabs of the record form, so an edit page has exactly one row of tabs.",
    "keywords": ["filament", "filament-plugin", "laravel", "relation-manager", "tabs"],
    "homepage": "https://github.com/asignua/filament-relation-manager-tabs",
    "support": {
        "issues": "https://github.com/asignua/filament-relation-manager-tabs/issues",
        "source": "https://github.com/asignua/filament-relation-manager-tabs"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentRelationManagerTabs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentRelationManagerTabs\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
